# Local proof workspaces (git-ignored scratch: fork clones, dev-env builds,
# boot worlds). Survives reboots (unlike /tmp). Disposable: any subdir can be
# re-derived from the tracked leg + docs/refactor TEST-REPORTs, but
# re-derivation costs full fork builds, so keep them around.
proof/
# Gradle build outputs (regenerated by build; includes standalone
# horizon-plugin project outputs).
.gradle/
build/
out/
# Server runtime files (a booted server writes these into its cwd: never
# track them; scratch servers belong under proof/ or /tmp, never repo root).
/server.jar
/horizon.yml
/libraries/
/world/
/logs/
/cache/
/nohup.out
/ops.json
/usercache.json
/whitelist.json
/banned-players.json
/banned-ips.json
