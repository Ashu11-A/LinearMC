+    // Linear - config-free format signal. LINEAR worlds carry .linear files
+    // (the offline converter lays them down before any flag flip; see UPGRADE.md),
+    // so one REGEX-matching *.linear/*.b_linear file selects the linear-family write side. Pure-Anvil
+    // folders keep the vanilla ANVIL side. Filesystem signal only.
+    private static net.linear.RegionFileFormat probeWriteFormat(final Path regionFolder) {
+        // Deterministic over listFiles order (which is undefined): scan all
+        // matches, preferring B_LINEAR when any buffered file is present,
+        // else LINEAR. Mixed folders are pathological (the converter
+        // escalates same-coordinates pairs instead of guessing); the write
+        // side must still pick exactly one format.
+        File[] files = regionFolder.toFile().listFiles((dir, name) -> name.endsWith(".linear") || name.endsWith(".b_linear"));
+        boolean seenLinear = false;
+        if (files != null) {
+            for (File file : files) {
+                if (REGEX.matcher(file.getName()).matches()) {
+                    if (file.getName().endsWith(".b_linear")) {
+                        return net.linear.RegionFileFormat.B_LINEAR;
+                    }
+                    seenLinear = true;
+                }
+            }
+        }
+        if (seenLinear) {
+            return net.linear.RegionFileFormat.LINEAR;
+        }
+        return net.linear.RegionFileFormat.ANVIL;
+    }
