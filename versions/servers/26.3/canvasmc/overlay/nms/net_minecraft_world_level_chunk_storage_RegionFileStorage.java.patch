+    // The guard below uses enum identity comparison; a String
+    // comparison would always be true and would disable the guard,
+    // so the one-line fix marked below is the only change needed.
+    private void guardAgainstBrokenSymlinks(Path path) throws java.io.IOException {
+        if (!this.linearCrashOnBrokenSymlink) return;
+        // Linear guard fix: enum identity comparison (a String comparison
+        //   if (!this.format.equals("LINEAR")) return;
+        // would always be true (an enum never equals a String) and disable
+        // the guard. Correct form:
+        if (!RegionFileFormat.isLinearFamily(this.format)) return;
+        if (!java.nio.file.Files.isSymbolicLink(path)) return;
+        Path link = java.nio.file.Files.readSymbolicLink(path);
+        if (!java.nio.file.Files.exists(link) || !java.nio.file.Files.isReadable(link)) {
+            LOGGER.error("Linear region file {} is a broken symbolic link, crashing to prevent data loss", path);
+            net.minecraft.server.MinecraftServer.getServer().halt(false);
+            throw new java.io.IOException("Linear region file " + path + " is a broken symbolic link, crashing to prevent data loss");
+        }
+    }
 
