From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LinearMC <linearmc@users.noreply.github.com>
Date: Mon, 29 Sep 2026 00:00:00 -0300
Subject: [PATCH] LinearMC: net/minecraft/world/level/chunk/storage/SimpleRegionStorage.java

Ported from the Folia feature stack (minecraft-0009-Linear-region-format.patch,
minecraft-0014-Linear-default-format.patch).
Rebased onto Canvas 26.3 build #1010 (a636063e): the 5-arg constructor no
longer writes info.dfuType()[0]; the new overloads only add the format
parameters and delegate to IOWorker.
---
diff --git a/net/minecraft/world/level/chunk/storage/SimpleRegionStorage.java b/net/minecraft/world/level/chunk/storage/SimpleRegionStorage.java
--- a/net/minecraft/world/level/chunk/storage/SimpleRegionStorage.java
+++ b/net/minecraft/world/level/chunk/storage/SimpleRegionStorage.java
@@ -39,6 +39,26 @@
         this.storage = new IOWorker(info, folder, syncWrites).storage; // Paper - rewrite chunk system
     }
 
+    // Linear - format-aware entry point. ChunkMap/PoiManager thread the world
+    // format + linear compression through here into IOWorker/RegionFileStorage.
+    // RegionStorageInfo itself is unchanged (Paper dfuType hack + record shape).
+    // Linear - 7-arg overload adds the crash flag; 6-arg delegates with default true.
+    public SimpleRegionStorage(
+        final RegionStorageInfo info, final Path folder, final DataFixer fixerUpper, final boolean syncWrites, final DataFixTypes dataFixType,
+        final net.linear.RegionFileFormat format, final int linearCompression
+    ) {
+        this(info, folder, fixerUpper, syncWrites, dataFixType, format, linearCompression, true);
+    }
+
+    public SimpleRegionStorage(
+        final RegionStorageInfo info, final Path folder, final DataFixer fixerUpper, final boolean syncWrites, final DataFixTypes dataFixType,
+        final net.linear.RegionFileFormat format, final int linearCompression, final boolean linearCrashOnBrokenSymlink
+    ) {
+        this.fixerUpper = fixerUpper;
+        this.dataFixType = dataFixType;
+        this.storage = new IOWorker(info, folder, syncWrites, format, linearCompression, linearCrashOnBrokenSymlink).storage; // Paper - rewrite chunk system // Linear - format
+    }
+
     public boolean isOldChunkAround(final ChunkPos pos, final int range) {
         return true; // Paper - rewrite chunk system
     }
