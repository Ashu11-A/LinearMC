-        this(info, folder, sync, RegionFileFormat.ANVIL, 1); // Linear - default preserves vanilla behavior
+        this(info, folder, sync, RegionFileFormat.LINEAR, 6); // Linear - default preserves the configured default (LINEAR, 6)
     }
 
