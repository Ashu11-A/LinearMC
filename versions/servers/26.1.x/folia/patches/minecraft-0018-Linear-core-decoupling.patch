@@ -0,0 +1,54 @@
+package net.minecraft.world.level.chunk.storage;
+
+import net.minecraft.world.level.ChunkPos;
+
+// Linear - NMS Anvil ChunkSink for reverse (.linear -> .mca) conversion.
+// Top-level (same package as RegionFile): registered in RegionFileStorage
+// and mirrored in the RegionStorageUpgrader trigger, which cannot see a
+// private nested class. Wraps a vanilla RegionFile (converter scope,
+// sync=false: Anvil writes are synchronous, so flush() is a no-op). Raw NBT
+// from the linear source is enveloped exactly like the streaming write path:
+// compress via the selected RegionFileVersion, then [int length][byte version][compressed].
+// Empty buffers are the delete-slot sentinel and clear the slot.
+public final class LinearAnvilSink implements net.linear.LinearRegionConverter.ChunkSink {
+    private final RegionFile file;
+
+    public LinearAnvilSink(final java.nio.file.Path file, final java.nio.file.Path folder) throws java.io.IOException {
+        this.file = new RegionFile(
+            new RegionStorageInfo("converter", net.minecraft.world.level.Level.OVERWORLD, "chunk"),
+            file, folder, false);
+    }
+
+    @Override
+    public void write(final long chunk, final java.nio.ByteBuffer data) throws java.io.IOException {
+        final ChunkPos pos = new ChunkPos(net.linear.ChunkKey.x(chunk), net.linear.ChunkKey.z(chunk));
+        if (!data.duplicate().hasRemaining()) {
+            this.file.clear(pos);
+            return;
+        }
+        final byte[] raw = new byte[data.remaining()];
+        data.duplicate().get(raw);
+        final net.minecraft.world.level.chunk.storage.RegionFileVersion version =
+            net.minecraft.world.level.chunk.storage.RegionFileVersion.getSelected();
+        final java.io.ByteArrayOutputStream compressed = new java.io.ByteArrayOutputStream(raw.length + 16);
+        try (java.io.OutputStream out = version.wrap(compressed)) {
+            out.write(raw);
+        }
+        final byte[] comp = compressed.toByteArray();
+        final java.nio.ByteBuffer enveloped = java.nio.ByteBuffer.allocate(4 + 1 + comp.length);
+        enveloped.putInt(comp.length + 1);
+        enveloped.put((byte) version.getId());
+        enveloped.put(comp);
+        enveloped.flip();
+        this.file.write(pos, enveloped);
+    }
+
+    @Override
+    public void flush() {
+    }
+
+    @Override
+    public void close() throws java.io.IOException {
+        this.file.close();
+    }
+}
