diff --git a/src/main/java/io/papermc/paper/linear/PaperFormatMapper.java b/src/main/java/io/papermc/paper/linear/PaperFormatMapper.java
new file mode 100644
index 000000000..057c18c7cace7a1c5f944a80825f20b1e391dd81 100644
--- /dev/null
+++ b/src/main/java/io/papermc/paper/linear/PaperFormatMapper.java
@@ -0,0 +1,30 @@
+package io.papermc.paper.linear;
+
+/**
+ * Paper-side config-to-core format mapping (Phase D).
+ *
+ * <p>Single mapping point from the Paper config enum
+ * ({@code io.papermc.paper.configuration.type.RegionFileFormat}) to the
+ * core enum ({@code net.linear.RegionFileFormat}). Takes {@code Object}
+ * and compares via {@code toString()} so this seam never imports the
+ * config type directly (avoids cross-tree type coupling). Callers
+ * (ServerChunkCache, ServerLevel,
+ * RegionStorageUpgrader.resolveTargetFormat) pass their raw
+ * {@code regionFormat.format} value through.</p>
+ *
+ * <p>Maps {@code LINEAR -> LINEAR}, everything else ({@code ANVIL},
+ * {@code null} pre-{@code @PostProcess} or direct unit-test calls) to
+ * {@code ANVIL}.</p>
+ */
+public final class PaperFormatMapper {
+
+    private PaperFormatMapper() {}
+
+    public static net.linear.RegionFileFormat map(final Object paperEnum) {
+        return paperEnum == null
+            ? net.linear.RegionFileFormat.ANVIL
+            : "LINEAR".equals(paperEnum.toString())
+                ? net.linear.RegionFileFormat.LINEAR
+                : net.linear.RegionFileFormat.ANVIL;
+    }
+}
