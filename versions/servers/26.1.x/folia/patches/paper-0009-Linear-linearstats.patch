@@ -0,0 +1,339 @@
+package io.papermc.paper.command;
+
+import java.io.File;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.UUID;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import net.linear.LinearFlushCoordinator;
+import net.linear.LinearRegionConverter;
+import net.linear.LinearRegionTimings;
+import net.linear.command.ConvertDirection;
+import net.linear.command.ConvertJob;
+import net.linear.command.InvalidUsageException;
+import net.linear.command.JobQueue;
+import net.linear.command.JobState;
+import net.linear.command.LinearAction;
+import net.linear.command.LinearCommandExecutor;
+import net.linear.command.LinearCommandParser;
+import net.linear.command.LinearPermissions;
+import net.linear.command.LinearTabCompleter;
+import net.linear.command.StatsProvider;
+import net.linear.config.LinearPolicy;
+import org.bukkit.Bukkit;
+import org.bukkit.World;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandSender;
+import org.jetbrains.annotations.NotNull;
+
+/**
+ * Linear {@code /linear} command tree (stats/convert/queue/help): thin Paper
+ * leg over command (single owner of the grammar, permissions and queue
+ * planning in {@code net.linear.command}).
+ *
+ * <p>Branch ownership: {@code stats} reuses the pinned
+ * {@code /linearstats} panel ({@link CommandLinearStats} stays untouched)
+ * by forwarding the grammar's optional world filter to it;
+ * {@code help} and
+ * {@code queue} (list/pause/resume/cancel/clear on the static
+ * {@link JobQueue} singleton) delegate to {@link LinearCommandExecutor};
+ * {@code convert} delegates submit hor planning to the executor too, then the
+ * leg drives execution.</p>
+ *
+ * <p>Permissions: no command-level node on purpose (each branch enforces its
+ * own {@link LinearPermissions} node; {@code help} is public). Usage errors
+ * print the parser {@code USAGE} text (already the tail of every
+ * {@link InvalidUsageException}).</p>
+ *
+ * <p>Convert execution (both directions {@code --execute}): the world
+ * folder resolves on the calling thread, then a dedicated daemon
+ * single-thread worker (never the tick thread) runs a quiesce gate
+ * ({@code flushAllDirty(true)} forced drain, abort unless every tracked
+ * folder reads {@code dirtyDepth == 0}) followed by
+ * {@code convertRegionFolder} per storage folder
+ * ({@code region/}, {@code entities/}, {@code poi/}, same set as the
+ * pre-plugin pass). The job moves {@code start/recordFile/complete/fail} on
+ * the worker; pause is polled in the per-file listener callback (the
+ * in-flight file always finishes first, converter pool threads pile into the
+ * pause loop as backpressure until resume); a terminal state (cancelled and
+ * friends) cannot interrupt the blocking pass, so late per-file records are
+ * dropped and the pre-existing terminal state wins.</p>
+ *
+ * <p>Dry-run only plans (candidate echo, nothing converted).
+ * Both directions {@code --execute} run on the worker via core
+ * {@code JobRunner} (direction switch owned by core).</p>
+ */
+public class CommandLinear extends Command {
+
+    /** Storage folders converted per world (same set as the pre-plugin pass). */
+    private static final List<String> STORAGE_FOLDERS = List.of("region", "entities", "poi");
+
+    /** Queue singleton: in-memory only (dropped on restart; boot logs the drop). */
+    private static final JobQueue QUEUE = new JobQueue();
+
+    /** Stats pull-through: coordinator snapshots (zero new storage, no threads). */
+    private static final StatsProvider STATS = LinearFlushCoordinator::snapshots;
+
+    /**
+     * Dedicated single-thread convert worker (daemon, never the tick thread).
+     * One pass at a time; further submits queue behind the running pass.
+     */
+    private static final ExecutorService CONVERT_EXECUTOR = Executors.newSingleThreadExecutor(r -> {
+        final Thread thread = new Thread(r, "linear-convert");
+        thread.setDaemon(true);
+        return thread;
+    });
+
+    private final LinearCommandExecutor executor = new LinearCommandExecutor(QUEUE, STATS);
+
+    public CommandLinear(@NotNull String name) {
+        super(name);
+        this.setDescription("Linear region commands (stats/convert/queue/help)");
+        this.setUsage(LinearCommandParser.USAGE);
+        this.setPermissionMessage(LinearPermissions.denied("linear"));
+    }
+
+    @Override
+    public boolean execute(@NotNull CommandSender sender, @NotNull String commandLabel, @NotNull String[] args) {
+        final LinearAction action;
+        try {
+            action = new LinearCommandParser().parse(args);
+        } catch (InvalidUsageException bad) {
+            sender.sendMessage(bad.getMessage());
+            return true;
+        }
+        if (action instanceof LinearAction.StatsAction stats) {
+            // Single rendering path: call the pinned panel, never fork it.
+            final String[] statsArgs = stats.worldFilter()
+                .map(world -> new String[]{world})
+                .orElseGet(() -> new String[0]);
+            return new CommandLinearStats("linearstats").execute(sender, commandLabel, statsArgs);
+        }
+        if (action instanceof LinearAction.ConvertAction convert) {
+            return this.executeConvert(sender, convert);
+        }
+        this.executor.execute(adapt(sender), action);
+        return true;
+    }
+
+    /**
+     * Convert submit (core-owned) plus leg execution. The executor enforces
+     * permissions, enqueues exactly one job and messages the sender; the new
+     * job is found by queue diff (nothing new means denied: fail closed, no
+     * launch). Dry-run only echoes candidates; both directions
+     * {@code --execute} reach the background worker (core JobRunner
+     * switches on direction).
+     */
+    private boolean executeConvert(@NotNull CommandSender sender, @NotNull LinearAction.ConvertAction convert) {
+        final Set<UUID> before = jobIds();
+        this.executor.execute(adapt(sender), convert);
+        final ConvertJob job = newJobSince(before);
+        if (job == null) {
+            return true;
+        }
+        if (convert.dryRun()) {
+            echoCandidates(sender, convert.world(), convert.direction());
+            return true;
+        }
+        final World world = Bukkit.getWorld(convert.world());
+        if (world == null) {
+            final String unknown = "Unknown world '" + convert.world() + "'.";
+            job.start();
+            job.fail(unknown);
+            sender.sendMessage(unknown);
+            return true;
+        }
+        final Path worldFolder = world.getWorldFolder().toPath();
+        final String sysLevel = System.getProperty(LinearPolicy.SYSPROP_LEVEL);
+        final int level = LinearPolicy.resolveLevel(
+            sysLevel, convert.level(), net.linear.RegionFileFormat.DEFAULT_COMPRESSION_LEVEL);
+        if (sysLevel != null && level != convert.level()) {
+            sender.sendMessage(LinearPolicy.overrideLine(LinearPolicy.SYSPROP_LEVEL, sysLevel,
+                String.valueOf(convert.level()), String.valueOf(level), "global"));
+        }
+        sender.sendMessage(net.linear.command.JobStatusView.statusLine(job, System.currentTimeMillis()));
+        CONVERT_EXECUTOR.execute(() -> runConvert(sender, job, level, worldFolder, convert.world(), convert.threads()));
+        return true;
+    }
+
+    /** Snapshot of queued job ids (single-threaded tick submit: exactly one new job appears). */
+    private static Set<UUID> jobIds() {
+        final Set<UUID> ids = new HashSet<>();
+        for (ConvertJob job : QUEUE.list()) {
+            ids.add(job.id());
+        }
+        return ids;
+    }
+
+    /** The single job submitted since {@code before}; null when none (denied) or ambiguous (fail closed). */
+    private static ConvertJob newJobSince(final Set<UUID> before) {
+        ConvertJob found = null;
+        for (ConvertJob job : QUEUE.list()) {
+            if (!before.contains(job.id())) {
+                if (found != null) {
+                    return null;
+                }
+                found = job;
+            }
+        }
+        return found;
+    }
+
+    /** Dry-run plan: candidate echo per storage folder (capped), nothing converted. */
+    private static void echoCandidates(@NotNull CommandSender sender, @NotNull String worldName, @NotNull ConvertDirection direction) {
+        final World world = Bukkit.getWorld(worldName);
+        if (world == null) {
+            sender.sendMessage("Dry-run plan: unknown world '" + worldName + "'.");
+            return;
+        }
+        final Path worldFolder = world.getWorldFolder().toPath();
+        final List<String> counts = new ArrayList<>();
+        final List<String> sample = new ArrayList<>();
+        int total = 0;
+        final String ext = direction == ConvertDirection.LINEAR_TO_MCA ? ".linear" : ".mca";
+        for (String folder : STORAGE_FOLDERS) {
+            final File dir = worldFolder.resolve(folder).toFile();
+            final String[] mca = dir.list((parent, name) -> name.endsWith(ext));
+            final int count = mca == null ? 0 : mca.length;
+            total += count;
+            counts.add(folder + "=" + count);
+            if (mca != null) {
+                for (String name : mca) {
+                    if (sample.size() < 20) {
+                        sample.add(folder + "/" + name);
+                    }
+                }
+            }
+        }
+        sender.sendMessage("Dry-run plan for '" + worldName + "': " + total
+            + " candidate " + ext + " file(s) (" + String.join(", ", counts) + "); nothing converted.");
+        for (String name : sample) {
+            sender.sendMessage("  " + name);
+        }
+        if (total > sample.size()) {
+            sender.sendMessage("  ... and " + (total - sample.size()) + " more.");
+        }
+    }
+
+    /**
+     * Background convert pass (worker thread, never tick): quiesce gate
+     * first, then core {@code JobRunner} over every storage folder
+     * (direction switch owned by core). Reverse jobs flip
+     * {@code LinearFormatOverride} to ANVIL so new writes land in
+     * {@code .mca} while unconverted {@code .linear} files keep serving
+     * reads through dual-read. Completion/failure notices reuse core
+     * {@code JobStatusView} templates and go to the originating sender
+     * (best-effort, falls back to the server log) and always to the log.
+     */
+    private static void runConvert(@NotNull CommandSender sender, @NotNull ConvertJob job, final int level, @NotNull Path worldFolder, @NotNull String worldName, final int threads) {
+        try {
+            job.start();
+        } catch (IllegalStateException alreadyTerminal) {
+            Bukkit.getLogger().info("[Linear] " + net.linear.command.JobStatusView.statusLine(job, System.currentTimeMillis()));
+            return;
+        }
+        try {
+            LinearFlushCoordinator.flushAllDirty(true);
+        } catch (RuntimeException gate) {
+            final String reason = "quiesce flush failed: " + gate.getMessage();
+            failQuietly(job, reason);
+            tell(sender, net.linear.command.JobStatusView.statusLine(job, System.currentTimeMillis()));
+            tell(sender, net.linear.command.JobStatusView.failedAction(reason));
+            return;
+        }
+        long dirty = 0L;
+        try {
+            for (LinearRegionTimings.LinearFolderSnapshot snapshot : STATS.snapshots().values()) {
+                dirty += Math.max(0, snapshot.dirtyDepth());
+            }
+        } catch (RuntimeException gate) {
+            final String reason = "quiesce snapshot failed: " + gate.getMessage();
+            failQuietly(job, reason);
+            tell(sender, net.linear.command.JobStatusView.statusLine(job, System.currentTimeMillis()));
+            tell(sender, net.linear.command.JobStatusView.failedAction(reason));
+            return;
+        }
+        if (dirty > 0L) {
+            final String stillDirty = "quiesce gate: " + dirty + " file(s) still dirty after forced flush; retry when worlds are idle.";
+            failQuietly(job, stillDirty);
+            tell(sender, net.linear.command.JobStatusView.statusLine(job, System.currentTimeMillis()));
+            tell(sender, net.linear.command.JobStatusView.failedAction(stillDirty));
+            return;
+        }
+        final java.util.List<Path> folders = new java.util.ArrayList<>();
+        for (String folder : STORAGE_FOLDERS) {
+            folders.add(worldFolder.resolve(folder));
+        }
+        final boolean reverse = job.direction() == ConvertDirection.LINEAR_TO_MCA;
+        if (reverse) {
+            net.linear.config.LinearFormatOverride.set(worldName, "ANVIL");
+            for (Path folderPath : folders) {
+                net.linear.config.LinearFormatOverride.set(folderPath.toString(), "ANVIL");
+            }
+        }
+        try {
+            net.linear.command.JobRunner.run(job, folders, level, threads);
+        } finally {
+            if (reverse) {
+                net.linear.config.LinearFormatOverride.clear(worldName);
+                for (Path folderPath : folders) {
+                    net.linear.config.LinearFormatOverride.clear(folderPath.toString());
+                }
+            }
+        }
+        final long nowMs = System.currentTimeMillis();
+        Bukkit.getLogger().info("[Linear] " + net.linear.command.JobStatusView.statusLine(job, nowMs));
+        tell(sender, net.linear.command.JobStatusView.statusLine(job, nowMs));
+        for (String line : net.linear.command.JobStatusView.detailLines(job, nowMs)) {
+            tell(sender, line);
+        }
+    }
+
+    /** Fails the job unless it already went terminal (operator cancel wins over failure). */
+    private static void failQuietly(@NotNull ConvertJob job, @NotNull String reason) {
+        try {
+            job.fail(reason);
+        } catch (IllegalStateException terminalWins) {
+            Bukkit.getLogger().info("[Linear] Convert job " + job.id() + " is already " + job.state()
+                + "; keeping terminal state over failure: " + reason);
+        }
+    }
+
+    /** Best-effort sender notice from the worker thread (falls back to the server log). */
+    private static void tell(@NotNull CommandSender sender, @NotNull String line) {
+        try {
+            sender.sendMessage(line);
+        } catch (RuntimeException lost) {
+            Bukkit.getLogger().info("[Linear] " + line);
+        }
+    }
+
+    /** Adapts the Bukkit sender to the core message sink (plain strings, no Adventure). */
+    private static net.linear.command.CommandSender adapt(@NotNull CommandSender sender) {
+        return new net.linear.command.CommandSender() {
+            @Override
+            public void sendMessage(final String message) {
+                sender.sendMessage(message);
+            }
+
+            @Override
+            public boolean hasPermission(final String permission) {
+                return sender.hasPermission(permission);
+            }
+
+            @Override
+            public String name() {
+                return sender.getName();
+            }
+        };
+    }
+
+    @Override
+    public @NotNull List<String> tabComplete(@NotNull CommandSender sender, @NotNull String alias, @NotNull String[] args) {
+        return LinearTabCompleter.suggest(args, QUEUE, () -> { try { final java.util.Set<String> names = new java.util.HashSet<>(); for (org.bukkit.World w : org.bukkit.Bukkit.getWorlds()) { names.add(w.getName()); } return names; } catch (RuntimeException empty) { return java.util.Collections.emptySet(); } });
+    }
+}
