From: folia-linear-build <folia-linear-build@users.noreply.github.com>
Date: Fri, 25 Sep 2026 15:56:19 -0300
Subject: [PATCH] Linear default format

Shipped default is LINEAR (level 6 flows from paper-0008); SLIM leg test
pins the file-layer mapping (case-sensitive), the level fallback (6) and
the shipped default (LINEAR).

---
 src/main/java/io/papermc/paper/configuration/WorldConfiguration.java |    4 ++--
 src/test/java/net/linear/LinearDefaultFormatTest.java                |   41 +++++++++++++++++++++++++++++++++++++++++
 2 files changed, 43 insertions(+), 2 deletions(-)
 create mode 100644 src/test/java/net/linear/LinearDefaultFormatTest.java

diff --git a/src/main/java/io/papermc/paper/configuration/WorldConfiguration.java b/src/main/java/io/papermc/paper/configuration/WorldConfiguration.java
index 29a32b85e..af9ead0cc 100644
--- a/src/main/java/io/papermc/paper/configuration/WorldConfiguration.java
+++ b/src/main/java/io/papermc/paper/configuration/WorldConfiguration.java
@@ -534,10 +534,10 @@ public class WorldConfiguration extends ConfigurationPart {
     public RegionFormat regionFormat;
 
     public class RegionFormat extends ConfigurationPart {
-        @Comment("Region file format for NEW files. ANVIL (default) or LINEAR. Unknown values log SEVERE and fall back to ANVIL. Reads always probe both extensions (dual-read from day 1, sibling A5-B1), so flipping this flag never hides existing data.")
+        @Comment("Region file format for NEW files. LINEAR (default) or ANVIL. Unknown values log SEVERE and fall back to ANVIL. Reads always probe both extensions (dual-read from day 1, sibling A5-B1), so flipping this flag never hides existing data.")
         @Setting("format")
-        public RegionFileFormat format = RegionFileFormat.ANVIL;
+        public RegionFileFormat format = RegionFileFormat.LINEAR;
         @Setting("linear")
         public Linear linear;
 
         public class Linear extends ConfigurationPart {
diff --git a/src/test/java/net/linear/LinearDefaultFormatTest.java b/src/test/java/net/linear/LinearDefaultFormatTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..1111111111111111111111111111111111111111
--- /dev/null
+++ b/src/test/java/net/linear/LinearDefaultFormatTest.java
@@ -0,0 +1,41 @@
+package net.linear;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import org.junit.jupiter.api.Test;
+
+/**
+ * SLIM leg: the file-layer mapping stays case-sensitive ({@code "linear"} is
+ * unknown and falls back to ANVIL), the shipped default is LINEAR, and the
+ * shared level fallback is 6. Single-owner policy lives in
+ * {@code net.linear.config.LinearPolicy}.
+ */
+public class LinearDefaultFormatTest {
+
+    @Test
+    public void fileLayerMappingIsCaseSensitive() {
+        assertEquals(
+            net.linear.RegionFileFormat.ANVIL, io.papermc.paper.linear.PaperFormatMapper.map(null));
+        assertEquals(
+            net.linear.RegionFileFormat.LINEAR, io.papermc.paper.linear.PaperFormatMapper.map("LINEAR"));
+        assertEquals(
+            net.linear.RegionFileFormat.ANVIL, io.papermc.paper.linear.PaperFormatMapper.map("linear"));
+    }
+
+    @Test
+    public void shippedDefaultIsLinear() {
+        assertEquals(net.linear.RegionFileFormat.LINEAR, net.linear.config.LinearPolicy.DEFAULT_FORMAT);
+        assertEquals(
+            net.linear.RegionFileFormat.LINEAR,
+            net.linear.config.LinearPolicy.resolveFormat(
+                null, null, net.linear.config.LinearPolicy.DEFAULT_FORMAT));
+    }
+
+    @Test
+    public void levelFallbackIsSix() {
+        assertEquals(6, net.linear.config.LinearPolicy.DEFAULT_LEVEL);
+        assertEquals(6, net.linear.config.LinearPolicy.resolveLevel(null, null, 6));
+        assertEquals(6, net.linear.config.LinearPolicy.resolveLevel("nope", null, 6));
+        assertEquals(7, net.linear.config.LinearPolicy.resolveLevel(null, 7, 6));
+    }
+}
