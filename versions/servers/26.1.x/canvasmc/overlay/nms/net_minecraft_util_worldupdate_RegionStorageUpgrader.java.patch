+
+    // Linear - config-free format signal. LINEAR worlds carry .linear files
+    // (the offline converter lays them down before any flag flip; see UPGRADE.md),
+    // so one REGEX-matching *.linear file selects the LINEAR write side. Pure-Anvil
+    // folders keep the vanilla ANVIL side. Filesystem signal only.
+    private static net.linear.RegionFileFormat probeWriteFormat(final Path regionFolder) {
+        File[] files = regionFolder.toFile().listFiles((dir, name) -> name.endsWith(net.linear.RegionFileFormat.LINEAR_EXTENSION));
+        if (files != null) {
+            for (File file : files) {
+                if (REGEX.matcher(file.getName()).matches()) {
+                    return net.linear.RegionFileFormat.LINEAR;
+                }
+            }
+        }
+        return net.linear.RegionFileFormat.ANVIL;
+    }
+
+    // Linear - startup auto-conversion mismatch detector (B2; minecraft-0015).
+    // Pure filesystem, config-free like probeWriteFormat above: true when the
+    // folder holds at least one REGEX-matching .mca file (old-format data the
+    // dual-read path still serves from .mca). The Paper pre-plugin hook calls
+    // this per storage folder (region/, entities/, poi/) and converts only
+    // when the world target (see resolveTargetFormat) is LINEAR.
+    public static boolean needsConversion(final Path regionFolder) {
+        File[] files = regionFolder.toFile().listFiles((dir, name) -> name.endsWith(net.linear.RegionFileFormat.ANVIL_EXTENSION));
+        if (files == null) {
+            return false;
+        }
+        for (File file : files) {
+            if (REGEX.matcher(file.getName()).matches()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    // Linear - startup auto-conversion per-world target resolution (B2; minecraft-0015).
+    // Called by the Paper pre-plugin hook with the world folder plus the config
+    // snapshot the caller already read via the Paper configuration API
+    // (level.paperConfig() does not exist yet: WorldConfiguration is created
+    // per ServerLevel AFTER STARTUP plugins, so the hook resolves from config
+    // files, never from a level instance).
+    //
+    // P1 SAFETY INVARIANT (negative assertion): this returns ANVIL for
+    // explicit-ANVIL worlds AND for unset/invalid values (the paper-enum mapper maps
+    // null and anything-but-LINEAR to ANVIL), and the hook converts ONLY when
+    // the returned target is LINEAR. Hence NO explicit-ANVIL path can reach
+    // conversion: dual-read keeps serving those worlds untouched. Only an
+    // explicit LINEAR world config selects LINEAR.
+    public static net.linear.RegionFileFormat resolveTargetFormat(
+        final Path regionFolder,
+        final net.linear.RegionFileFormat configuredFormat
+    ) {
+        // regionFolder identifies the world for log correlation and any future
+        // filesystem signal; the decision itself is config-only (see invariant).
+        // Canvas passes the core enum straight from WorldConfig (Folia maps its
+        // paperConfig enum through its paper-enum mapper instead).
+        return configuredFormat == null ? net.linear.RegionFileFormat.ANVIL : configuredFormat;
+    }
+
+    // Linear - startup auto-conversion entry point (B2; minecraft-0015).
+    // Callable OUTSIDE the --recreateRegionFiles/DFU flow: converts every .mca
+    // file in ONE folder (region/, entities/, or poi/) to LINEAR at the given
+    // compression level, with no DataFixer gymnastics beyond what the shared
+    // recreate machinery already performs.
+    //
+    // B1 DEPENDENCY (ordering: this patch applies AFTER B1's minecraft-0014):
+    // the level flows through AbstractRegionFileFactory.clampCompressionLevel
+    // (single source of truth: never a literal and never a second inline range
+    // check here), so out-of-range values fall back to
+    // DEFAULT_COMPRESSION_LEVEL and B1's tuned default (level 6) reaches the
+    // startup conversion write side unchanged.
+    //
+    // B3 DEPENDENCY (cross-agent contract, signatures fixed): this method is a
+    // thin hop from the boot hook to
+    // net.linear.LinearRegionConverter.convertRegionFolder, which owns the file
+    // work plus the retry machinery (maxAttempts=3 internal). The halt itself
+    // does NOT live in the converter: when a file exhausts retries the
+    // converter throws ConversionProtectionException (carrying the per-file
+    // summary), and the Paper hook (paper-0011) logs the terminal alert and
+    // halts the server before plugins load. Signature and nested
+    // Status/FileResult types stay B3-owned and untouched.
+    public static net.linear.LinearRegionConverter.ConversionSummary convertFolderToLinear(
+        final Path regionFolder,
+        final int compressionLevel,
+        final net.linear.LinearRegionConverter.Listener listener
+    ) throws net.linear.LinearRegionConverter.ConversionProtectionException {
+        // Linear - converter ANVIL-source opens need the NMS-backed opener, and this
+        // choke point (startup + recreate) can run before any RegionFileStorage
+        // exists. Idempotent; mirrors the storage-ctor registration (core owns
+        // dispatch, legs own NMS construction — RegionFile is FQN here since the
+        // widened FileToUpgrade import dropped the NMS RegionFile import).
+        net.linear.AbstractRegionFileFactory.linear$setAnvilOpener((info, file, dir, sync) ->
+            (AbstractRegionFile)(Object) new net.minecraft.world.level.chunk.storage.RegionFile((RegionStorageInfo) info, file, dir, sync));
+        net.linear.AbstractRegionFileFactory.linear$setLinearOpener(net.linear.LinearRegionFile::new);
+        net.linear.LinearRegionConverter.linear$setRegionOpener((file, openFolder, openSync, format, level) ->
+            net.linear.AbstractRegionFileFactory.get(file,
+                new RegionStorageInfo("converter", net.minecraft.world.level.Level.OVERWORLD, "chunk"),
+                openFolder, openSync, level));
+        // Linear - reverse writer injection, same as the storage-ctor seam:
+        // raw NBT from the linear source is enveloped by the NMS sink.
+        net.linear.LinearRegionConverter.linear$setChunkSinkOpener((file, folder, level) ->
+            new io.papermc.paper.linear.AnvilChunkSink(file, folder));
+        // Loaded-region exclusion is operator guidance (see storage-ctor seam).
+        // Open-but-clean handles stay undetected; shadow protection is the backstop.
+        // Skip via core isFolderDirty (tracked-dirty defers; never-tracked
+        // proceeds: every Linear write is tracked, so unseen means clean).
+        net.linear.LinearRegionConverter.linear$setReverseSkipPredicate(path -> {
+            try {
+                final Path parent = path.toAbsolutePath().getParent();
+                if (parent == null) {
+                    return true;
+                }
+                return net.linear.LinearFlushCoordinator.isFolderDirty(parent);
+            } catch (RuntimeException skipped) {
+                return true;
+            }
+        });
+        // Linear - forward skip parity (soak fix, d-load Oct 2026): the live
+        // forward convert used to queue every .mca blindly while reverse
+        // deferred loaded files. Same folder-dirty check, so loaded regions
+        // defer in both directions instead of racing live writes.
+        // Open-but-clean handles stay undetected; shadow protection is the backstop.
+        // Skip via core isFolderDirty (tracked-dirty defers; never-tracked.
+        net.linear.LinearRegionConverter.linear$setForwardSkipPredicate(path -> {
+            try {
+                final Path parent = path.toAbsolutePath().getParent();
+                if (parent == null) {
+                    return true;
+                }
+                return net.linear.LinearFlushCoordinator.isFolderDirty(parent);
+            } catch (RuntimeException skipped) {
+                return true;
+            }
+        });
+        return net.linear.LinearRegionConverter.convertRegionFolder(
+            regionFolder, AbstractRegionFileFactory.clampCompressionLevel(compressionLevel), listener);
     }
 
